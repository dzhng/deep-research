# Search provider: "firecrawl" (default) or "exa"
# SEARCH_PROVIDER="firecrawl"

# Firecrawl (default search provider)
FIRECRAWL_KEY="YOUR_KEY"
# If you want to use your self-hosted Firecrawl, add the following below:
# FIRECRAWL_BASE_URL="http://localhost:3002"
# FIRECRAWL_CONCURRENCY="2"

# Exa (alternative search provider, https://exa.ai)
# To use Exa, set SEARCH_PROVIDER="exa" above and provide an API key:
# EXA_API_KEY="YOUR_KEY"
# Optional Exa tuning:
# EXA_SEARCH_TYPE="auto"        # auto | neural | fast | deep | deep-lite | deep-reasoning | instant
# EXA_CATEGORY="research paper" # company | research paper | news | pdf | personal site | financial report | people
# EXA_INCLUDE_DOMAINS="arxiv.org,nature.com"
# EXA_EXCLUDE_DOMAINS="reddit.com"
# EXA_START_PUBLISHED_DATE="2024-01-01"
# EXA_END_PUBLISHED_DATE="2026-12-31"

OPENAI_KEY="YOUR_KEY"
CONTEXT_SIZE="128000"

# If you want to use other OpenAI compatible API, add the following below:
# OPENAI_ENDPOINT="http://localhost:11434/v1"
# CUSTOM_MODEL="llama3.1"

# If you want to use fireworks.ai's DeepSeek R1 model:
# FIREWORKS_KEY="YOUR_KEY"
