FIRECRAWL_KEY="YOUR_KEY"
# If you want to use your self-hosted Firecrawl, add the following below:
# FIRECRAWL_BASE_URL="http://localhost:3002"
# FIRECRAWL_CONCURRENCY="2"

OPENAI_KEY="YOUR_KEY"
CONTEXT_SIZE="128000"

# If you want to use other OpenAI compatible API, add the following below:
# OPENAI_ENDPOINT="http://localhost:11434/v1"
# CUSTOM_MODEL="llama3.1"

# If you want to use fireworks.ai's DeepSeek R1 model:
# FIREWORKS_KEY="YOUR_KEY"

# --- API Server Configuration ---
# API_KEY="your-secret-key"
# If set, all /api/* requests must include x-api-key header
# If unset, the API is publicly accessible

# ALLOWED_ORIGINS="https://app.example.com,https://admin.example.com"
# Comma-separated list of allowed CORS origins
# If unset, all origins are allowed

# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=30
# Rate limiting: max requests per time window (default: 30 per 15 minutes)
